# Connext Environment Variables Example
PORT=5000
NODE_ENV=development

# Database Connection:
# Default to running local MongoDB Community Server (0 cost, completely offline/local)
MONGODB_URI=mongodb://127.0.0.1:27017/connext
# Or user-supplied MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://nairsdhruv_db_user:aSDD5t50AeR4imr3@connext.2kfdwzx.mongodb.net/connext?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=connext_super_secret_jwt_key_local_dev_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Mapping & Routing (Public Open-Source Service Endpoints)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Room Expiry Defaults (in minutes)
HANGOUT_ROOM_TTL_HOURS=24
MEETUP_ROOM_GRACE_HOURS=6
